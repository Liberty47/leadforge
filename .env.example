# Lead Forge Environment Variables
# Copy this file to .env and fill in your credentials

# Supabase Configuration
# Get these from your Supabase project settings at https://supabase.com/dashboard
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are SAFE for client
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side secrets - NEVER expose these as VITE_* variables
# Get from Supabase dashboard > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Serper API - Google Search for Lead Discovery
# Get your API key from https://serper.dev
SERPER_API_KEY=your-serper-api-key

# OpenRouter API - AI Email Personalization
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key

# Resend API - Email Sending
# Get your API key from https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret

# From Email Configuration
FROM_EMAIL=no-reply@leadforge.app

# Telegram Bot (Optional) - Application owner credentials only
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# WhatsApp Business API (Optional) - Application owner credentials only
# Get credentials from https://business.facebook.com
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# Activation System - Application owner credentials only
# This is used to verify activation keys server-side
ACTIVATION_SECRET=your-activation-secret-key

# Application Settings
NODE_ENV=development
PORT=5173
